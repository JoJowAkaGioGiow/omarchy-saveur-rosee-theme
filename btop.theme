# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#191724"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#e0def4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#31748f"

# Background color of selected item in processes box. #e0def4 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #302e3a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#302e3a"

# Foreground color of selected item in processes box. Use #e0def4 so
# the row text stays readable on the lighter_bg highlight; the previous
# #31748f produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#e0def4"

# Color of inactive/disabled text
theme[inactive_fg]="#26233a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e5e3f6 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #e0def4 directly.
theme[graph_text]="#e0def4"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #e0def4 collapsed to the main fg.
theme[meter_bg]="#302e3a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #ebbcba for a distinct accent instead of #e5e3f6 which capped to white.
theme[proc_misc]="#ebbcba"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c4a7e7"
theme[mem_box]="#9ccfd8"
theme[net_box]="#eb6f92"
theme[proc_box]="#31748f"

# Box divider line and small boxes line color
theme[div_line]="#26233a"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#9ccfd8"
theme[temp_mid]="#f6c177"
theme[temp_end]="#eb6f92"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#ebbcba"
theme[cpu_mid]="#31748f"
theme[cpu_end]="#c4a7e7"

# Mem/Disk free meter
theme[free_start]="#c4a7e7"
theme[free_mid]="#31748f"
theme[free_end]="#ebbcba"

# Mem/Disk cached meter
theme[cached_start]="#31748f"
theme[cached_mid]="#ebbcba"
theme[cached_end]="#c4a7e7"

# Mem/Disk available meter
theme[available_start]="#f6c177"
theme[available_mid]="#eb6f92"
theme[available_end]="#eb6f92"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#9ccfd8"
theme[used_mid]="#ebbcba"
theme[used_end]="#31748f"

# Download graph colors
theme[download_start]="#f6c177"
theme[download_mid]="#eb6f92"
theme[download_end]="#eb6f92"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#9ccfd8"
theme[upload_mid]="#ebbcba"
theme[upload_end]="#31748f"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ebbcba"
theme[process_mid]="#31748f"
theme[process_end]="#c4a7e7"
